# OpenAI-compatible provider (OpenRouter by default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...

# Model roles
FIXER_MODEL=anthropic/claude-sonnet-4.5
HINT_MODEL=google/gemini-3.5-flash-lite
VALIDATOR_MODEL=google/gemini-3.5-flash

# Loop limits
MAX_FIX_ATTEMPTS=3
MAX_HINT_ATTEMPTS=3

# Retrieval (see the README for what each depth buys)
RETRIEVAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_RERANK_DEPTH=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK=true
RETRIEVAL_CACHE_DIR=.rag_cache

# Evaluation harness only (evals/), never read by the service.
# The judge must not be the model being judged.
EVAL_ANSWER_MODEL=google/gemini-3.5-flash-lite
EVAL_JUDGE_MODEL=anthropic/claude-haiku-4.5

# Sandbox
# `docker` (the default) or `local`. There is no `auto`: if the daemon is unreachable the
# session fails with sandbox_unavailable rather than quietly running untrusted code under
# the weaker subprocess isolation. `docker pull python:3.13-alpine` before the first run.
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=python:3.13-alpine
SANDBOX_TIMEOUT_SEC=5
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=8000

# Guardrails. All on in the service; the switches exist so the attack suite can measure
# what each layer is worth by running the same scenario with one of them off.
CODESHIELD_ENABLED=true
INPUT_FILTER_ENABLED=true
OUTPUT_FILTER_ENABLED=true

# Tracing. A database backend, not ./mlruns — MLflow 3 refuses the file store, and the
# trace search and feedback APIs the eval harness runs on need it anyway.
TRACING_ENABLED=true
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=problem-helper

# 0.0 for the service, so re-opening a session gives the student the same advice. The agent
# eval raises it for its own runs (evals/run_agent.py --temperature).
LLM_TEMPERATURE=0.0

# Storage and HTTP
DB_PATH=problem_helper.db
CHECKPOINT_DB_PATH=problem_helper_checkpoints.db
HOST=127.0.0.1
PORT=8000
