# OpenAI-compatible provider (OpenRouter by default)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...

# Model roles
FIXER_MODEL=anthropic/claude-sonnet-4.5
HINT_MODEL=google/gemini-3.5-flash-lite
VALIDATOR_MODEL=google/gemini-3.5-flash

# Loop limits
MAX_FIX_ATTEMPTS=3
MAX_HINT_ATTEMPTS=3

# Retrieval (see the README for what each depth buys)
RETRIEVAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=20
RETRIEVAL_RERANK_DEPTH=20
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK=true
RETRIEVAL_CACHE_DIR=.rag_cache

# Evaluation harness only (evals/), never read by the service.
# The judge must not be the model being judged.
EVAL_ANSWER_MODEL=google/gemini-3.5-flash-lite
EVAL_JUDGE_MODEL=anthropic/claude-haiku-4.5

# Sandbox
SANDBOX_TIMEOUT_SEC=5
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OUTPUT_BYTES=8000

# Storage and HTTP
DB_PATH=problem_helper.db
CHECKPOINT_DB_PATH=problem_helper_checkpoints.db
HOST=127.0.0.1
PORT=8000
